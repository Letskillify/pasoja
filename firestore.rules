rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Secure Setup:
    // 1. Allow anyone to read data (needed for customers to view products/categories/blogs)
    // 2. Only allow the logged-in administrator (super@pasoja.in) to write, update, delete, or import data.
    
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'super@pasoja.in';
    }
  }
}
