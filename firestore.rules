rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'super@pasoja.in';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Products rules: everyone can read, super admin manages items, stock update allowed on order placement
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if true; // Allowed for stock level reduction upon customer order placement
    }
    
    // Users rules: allow listing/get (query checks for register lookup), restrict sub-collections to owners
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Orders rules: allow anyone to create, allow reads by superAdmin, by the authenticated owner,
    // by a Firebase Auth user whose email matches, OR publicly (for OTP-based customer sessions
    // who have no Firebase Auth — order IDs are Firestore auto-generated random strings,
    // effectively unguessable, so public read is acceptable for a boutique context).
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update: if true;   // Needed for Shiprocket tracking sync after order creation
      allow delete: if isSuperAdmin();
    }
    
    // Coupons rules: everyone can read (to apply at checkout), only admin can write
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Customers collection: stores shipping profile for every buyer (guest or logged-in)
    // Used as the source of truth for OTP-based customer login.
    // Email is used as document ID (sanitised). Anyone can read (for login lookup),
    // anyone can create/update (needed during guest checkout), only admin can delete.
    match /customers/{customerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // CMS & Storefront Dynamic Content Collections: everyone can read, only super admin can write
    match /hero_slides/{slideId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /shop_by_category/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /mobile_categories/{catId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /benefits_strip/{benefitId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /shop_the_look/{lookId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /community_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /community_images/{imageId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /community_stats/{statId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /subcategories/{subcatId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /collections/{colId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /attributes/{attrId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Returns & Refunds
    match /returns/{returnId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // Admin Profile & System Logs
    match /admin_profile/{profileId} {
      allow read, write: if isSuperAdmin();
    }

    match /activity_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    // Global fallback for any other collections
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
